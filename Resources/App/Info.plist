<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<!-- Xcode drops unknown INFOPLIST_KEY_* settings. These references expand
	     into Contents/Info.plist before code signing. Empty WATT_UPDATE_* values
	     stay empty so a debug or local build is not configured for updates. -->
	<key>WATTHelperTrustMode</key>
	<string>$(WATT_HELPER_TRUST_MODE)</string>
	<key>WATTSigningTeam</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>WATTUpdateArtifactURL</key>
	<string>$(WATT_UPDATE_ARTIFACT_URL)</string>
	<key>WATTUpdateManifestURL</key>
	<string>$(WATT_UPDATE_MANIFEST_URL)</string>
	<key>WATTUpdatePublicKey</key>
	<string>$(WATT_UPDATE_PUBLIC_KEY)</string>
</dict>
</plist>
